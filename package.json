{
  "version": "0.2.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "build": "esbuild src/index.ts --bundle --format=esm --loader:.gif=dataurl --loader:.png=dataurl --platform=neutral --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "db:init:local": "wrangler d1 execute DB --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute DB --remote --file=schema.sql"
  },
  "dependencies": {
    "hono": "^4.13.7",
    "@sundoge/kysely-d1": "^0.3.0",
    "kysely": "^0.29.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "4.107.0",
    "miniflare": "4.20260701.0"
  },
  "name": "moe-counter-cf",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "^0.35.4",
      "undici": "^7.29.0"
    }
  }
}
